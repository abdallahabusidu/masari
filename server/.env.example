# ---- Server ----
PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/masari
CLIENT_ORIGIN=http://localhost:5173

# ---- Auth (JWT) ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Email (SMTP) for deadline reminders ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Masari <no-reply@masari.app>"

# ---- Reminder job ----
REMINDER_CRON=*/15 * * * *
REMINDER_LOOKAHEAD_HOURS=24

# ---- Admin panel ----
ADMIN_PASSWORD=admin123
ADMIN_TOKEN_TTL=2h
